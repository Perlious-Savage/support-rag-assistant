LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
FALLBACK_PROVIDER=gemini
FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK_API_KEY=
FALLBACK_MODEL=gemini-3.7-flash
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Retrieval confidence threshold: refuse without calling the LLM below this cosine score
MIN_SCORE=
# Optional local LLM tier (tried after primary + fallback). Any OpenAI-compatible server, no key needed.
# Ollama: LOCAL_BASE_URL=http://localhost:11434/v1  LOCAL_MODEL=qwen2.5:1.5b
LOCAL_BASE_URL=
LOCAL_MODEL=
